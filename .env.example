# Puerto HTTP del servicio
PORT=3000

# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Orden de failover: lista separada por comas de proveedores a intentar, en orden.
# Proveedores disponibles de fabrica: mailgun, sendgrid, postmark
PROVIDER_ORDER=mailgun,sendgrid,postmark

# Modo de simulacion de cada proveedor mock (no se usan credenciales reales):
#   healthy -> siempre responde OK (con latencia simulada)
#   flaky   -> falla de forma transitoria las primeras N veces y luego responde OK
#   down    -> siempre falla con error transitorio (simula 503/timeout)
MAILGUN_MODE=healthy
SENDGRID_MODE=healthy
POSTMARK_MODE=healthy

# Cuantos intentos fallidos simula un proveedor en modo "flaky" antes de responder OK
MAILGUN_FLAKY_FAILURES=2
SENDGRID_FLAKY_FAILURES=2
POSTMARK_FLAKY_FAILURES=2

# Latencia simulada (ms) de cada proveedor mock
PROVIDER_SIMULATED_LATENCY_MS=50

# Politica de reintentos por proveedor antes de hacer failover al siguiente
MAX_RETRIES_PER_PROVIDER=2
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=2000

# Circuit breaker por proveedor: si un proveedor acumula esta cantidad de
# fallos consecutivos (contando entre peticiones distintas, no solo
# reintentos dentro de una misma peticion), se deja de contactarlo durante
# CIRCUIT_BREAKER_OPEN_DURATION_MS (fail-fast, sin gastar red ni reintentos),
# y se pasa directo al siguiente proveedor de la cadena. Pasado ese tiempo,
# se permite un intento de prueba (half-open): si responde OK, el circuito
# se cierra; si vuelve a fallar, se reabre.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_DURATION_MS=30000
